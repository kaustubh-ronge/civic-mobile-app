{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "PASTE_YOUR_ACTUAL_CLERK_KEY_HERE",
        "EXPO_PUBLIC_API_URL": "PASTE_YOUR_ACTUAL_LOCAL_IP_URL_HERE"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "",
        "EXPO_PUBLIC_API_URL": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}